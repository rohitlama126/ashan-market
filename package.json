{
  "name": "ashan-market",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@ashan/web",
    "dev:mobile": "pnpm --filter @ashan/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "tokens": "pnpm --filter @ashan/tokens generate",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts && prettier --write packages/db/src/database.types.ts",
    "format": "prettier --write .",
    "db:test": "supabase test db",
    "db:seed:build": "node supabase/seed/build-seed.mjs"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "supabase": "^2.122.0",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
