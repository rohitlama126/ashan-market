# Copy to apps/web/.env.local and apps/mobile/.env.local and fill in real values.
# Never commit real keys. Values below are placeholders, not working keys.
# The milestone that needs each variable is noted beside it.

# ── Telemetry (keep local tools quiet) ───────────────────────────────
NEXT_TELEMETRY_DISABLED=1
EXPO_NO_TELEMETRY=1

# ── Supabase (M1/M2) ─────────────────────────────────────────────────
# Local stack: `pnpm db:start` prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never expose to clients.
SUPABASE_SERVICE_ROLE_KEY=

# ── Auth providers (M2) ──────────────────────────────────────────────
# These secrets are read by the Supabase CLI from supabase/.env (copy this block there).
# Client IDs are not secret and live in supabase/config.toml; flip `enabled = true` there too.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
# Optional, real SMS for phone sign-in (local dev uses the test number in config.toml)
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=

# ── Stripe (M5), test mode keys start with pk_test_ / sk_test_ ──────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EXPO_PUBLIC_APPLE_PAY_MERCHANT_ID=merchant.com.ashanmarket

# ── EasyPost (M5), test key ─────────────────────────────────────────
EASYPOST_API_KEY=
EASYPOST_WEBHOOK_SECRET=

# ── Email (M8) ───────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Ashan Market <orders@example.com>"

# ── Push (M8) ────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ── App ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FREE_SHIPPING_THRESHOLD_CENTS=4900
