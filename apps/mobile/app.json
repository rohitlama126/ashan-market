{
  "expo": {
    "name": "Ashan Market",
    "slug": "ashan-market",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ashanmarket",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ashanmarket.app",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96,
          "dark": { "backgroundColor": "#14110F" }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
